# Server-only settings. Never use NEXT_PUBLIC_ for credentials.
MONGODB_URI=
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Free-plan candidate (requires your own Groq account/key).
# Free-only blocks automatic switching to Gemini; it cannot inspect account billing.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_FREE_ONLY=true
AI_DAILY_REQUEST_LIMIT=40
AI_DAILY_TOKEN_LIMIT=150000

# Optional Groww API subscription. Used only to read holdings/quotes.
GROWW_ACCESS_TOKEN=

# Optional explicit provider switch: AI_PROVIDER=gemini and AI_FREE_ONLY=false.
# Keys in one Google project share quotas. No quota-bypass rotation.
GEMINI_API_KEY_1=
GEMINI_MODEL=gemini-3.8-flash

# External scheduler bearer secret; Telegram delivery is opt-in via these values.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_DRY_RUN=true

# Round-trip fee estimate and each-side slippage for plans and paper simulation.
PAPER_COST_BPS=20
PAPER_SLIPPAGE_BPS=5
